<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atham_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/athamCallsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="N0CALL"
                android:textColor="@color/atham_gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/athamDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="KV4P HT"
                android:textColor="@color/atham_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/athamFrequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="146.5200"
            android:textColor="@color/atham_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/athamUnkey"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:minWidth="48dp"
            android:text="Unkey"
            android:textAllCaps="false"
            android:textColor="@color/atham_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@color/atham_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/sectionHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/homeConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/atham_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/homeFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="146.5200"
                    android:textColor="@color/atham_text"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/homeMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="FM  ·  Simplex  ·  Squelch 2  ·  Tone off"
                    android:textColor="@color/atham_muted"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/launchRadio"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Talk"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/launchScan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Scan"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/launchLog"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Log a contact"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/launchClassic"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="KV4P Classic"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionRadio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/radioState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disconnected"
                    android:textColor="@color/atham_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/radioFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="146.5200"
                    android:textColor="@color/atham_text"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/radioMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="FM  ·  Simplex  ·  Tone off  ·  Squelch 2"
                    android:textColor="@color/atham_muted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/radioFrequencyInput"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:background="@android:color/transparent"
                    android:hint="Frequency"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="146.5200"
                    android:textColor="@color/atham_text"
                    android:textColorHint="@color/atham_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/radioTune"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="0dp"
                        android:text="Tune"
                        android:textAllCaps="false"
                        android:textColor="@color/atham_text"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/radioConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:text="Connect"
                        android:textAllCaps="false"
                        android:textColor="@color/atham_text"
                        android:textSize="17sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/radioSignal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Plug in a KV4P HT to tune, scan, and talk."
                    android:textColor="@color/atham_muted"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/radioScan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:text="Scan memories"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/radioPtt"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="24dp"
                    android:background="@android:color/transparent"
                    android:text="Hold to talk"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="18sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log"
                    android:textColor="@color/atham_text"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/logBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:text="No contacts yet."
                    android:textColor="@color/atham_muted"
                    android:textSize="16sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionModules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modules"
                    android:textColor="@color/atham_text"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/modulesHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Radio stays on 146.5200"
                    android:textColor="@color/atham_muted"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/moduleVoice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:text="VoiceLog"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/modulePacket"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:text="Packet"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/moduleDevices"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:text="Devices"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Digital"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Mail"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Mesh"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Spectrum"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Maps"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:text="Tools"
                    android:textColor="@color/atham_muted"
                    android:textSize="17sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/sectionVoice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VoiceLog"
                    android:textColor="@color/atham_text"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/voiceContext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2 m  ·  FM  ·  Simplex"
                    android:textColor="@color/atham_muted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/voiceHeard"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="24dp"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="What you heard"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="0dp"
                    android:textColor="@color/atham_text"
                    android:textColorHint="@color/atham_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/atham_line" />

                <EditText
                    android:id="@+id/voiceCallsign"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:hint="Callsign"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/atham_text"
                    android:textColorHint="@color/atham_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <EditText
                    android:id="@+id/voiceReport"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:hint="Report"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/atham_text"
                    android:textColorHint="@color/atham_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <EditText
                    android:id="@+id/voiceName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:hint="Name"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:textColor="@color/atham_text"
                    android:textColorHint="@color/atham_muted"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/atham_line" />

                <Button
                    android:id="@+id/voiceFinalize"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="0dp"
                    android:text="Finalize"
                    android:textAllCaps="false"
                    android:textColor="@color/atham_text"
                    android:textSize="17sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/atham_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/atham_black"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="@color/atham_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/navRadio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Radio"
            android:textAllCaps="false"
            android:textColor="@color/atham_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/navLog"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Log"
            android:textAllCaps="false"
            android:textColor="@color/atham_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/navModules"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Modules"
            android:textAllCaps="false"
            android:textColor="@color/atham_muted"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
