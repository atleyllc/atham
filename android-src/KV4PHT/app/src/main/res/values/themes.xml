<resources>
    <style name="Base.Theme.KV4PHT" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/jost</item>
        <item name="fontFamily">@font/jost</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:colorBackground">@color/atley_background</item>
        <item name="colorPrimary">@color/atley_bronze</item>
        <item name="colorOnPrimary">@color/atley_on_bronze</item>
        <item name="colorSecondary">@color/atley_titanium</item>
        <item name="colorOnSecondary">@color/atley_on_bronze</item>
        <item name="colorSurface">@color/atley_surface</item>
        <item name="colorOnSurface">@color/atley_foreground</item>
        <item name="colorError">@color/atley_danger</item>
        <item name="android:textColorPrimary">@color/atley_foreground</item>
        <item name="android:textColorSecondary">@color/atley_muted</item>
        <item name="android:popupMenuStyle">@style/Custom.PopupMenu</item>
    </style>

    <style name="Theme.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/atley_bronze_soft</item>
    </style>

    <style name="Custom.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textSize">20dp</item>
    </style>

    <style name="Theme.KV4PHT" parent="Base.Theme.KV4PHT" />
</resources>
